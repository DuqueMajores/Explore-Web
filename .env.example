# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - PORTAL DE NOTÍCIAS SQLITE
# ==============================================================
# IMPORTANTE: Nunca envie senhas ou chaves reais para o repositório Git!
# Copie este arquivo para .env e ajuste os valores se necessário.

# Chave secreta da aplicação Flask (usada para sessões e cookies)
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Caminho opcional personalizado para o arquivo SQLite no servidor
# Se não for informado, utilizará por padrão: instance/database.sqlite3
SQLITE_PATH=instance/database.sqlite3

# Ou URL direta de conexão SQLAlchemy (exclusivamente SQLite local):
DATABASE_URL=sqlite:///instance/database.sqlite3

# Diretório de snapshots HTML permanentes (use um volume persistente em produção)
# STATIC_ARTICLES_DIR=noticia

# Chave de API do NewsAPI (obtenha em https://newsapi.org)
NEWS_API_KEY=sua_chave_newsapi_aqui

# Intervalo da verificação automática de páginas em minutos (padrão: 60)
CLEANUP_INTERVAL_MINUTES=60

# Intervalo da sincronização automática de notícias em minutos (padrão: 15)
NEWS_SYNC_INTERVAL_MINUTES=15

# Porta do servidor Flask (padrão: 5000)
PORT=5000
FLASK_ENV=production
